DB_URL=jdbc:postgresql://localhost:5432/me_may_dev
DB_USER=me_may_app
DB_PASSWORD=replace_with_your_local_database_password
TEST_DB_URL=jdbc:postgresql://localhost:5432/me_may_test
# M5 online test only; local DB_URL/TEST_DB_URL remain separate.
NEON_DATABASE_URL=
# Flyway needs the direct/non-pooled URL (connection pooling off).
NEON_DATABASE_URL_UNPOOLED=
# Only used by the explicit create_owner.py command; never exported to Render.
OWNER_EMAIL=
OWNER_PASSWORD=

# Cloudinary backend only; optional until media use
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_NAMESPACE=memay/dev

# M3 contact links: HTTPS zalo.me, blank disables outgoing links.
CONTACT_ZALO_HOTLINE_URL=
CONTACT_ZALO_GROUP_URL=

# Render: generate .local/render.env with scripts/deploy/prepare_render_env.py.
# NEON_JDBC_URL/NEON_JDBC_URL_UNPOOLED/NEON_DB_USER/NEON_DB_PASSWORD are generated.
# Create a fixed owner once with scripts/deploy/create_owner.py; no startup bootstrap.

# Public edge cache: backend-only Cloudflare API token scoped to this zone,
# permission Zone > Cache Purge. Both values required before cache-policy enables.
MEMAY_CACHE_ZONE_ID=
MEMAY_CACHE_PURGE_TOKEN=

# Local image storage foundation
MEMAY_IMAGE_LOCAL_ENABLED=false
MEMAY_IMAGE_ROOT=/srv/memay/images
MEMAY_IMAGE_NGINX_ORIGIN=http://image-nginx:8080
# Enable only on a separate management listener, kept on the worker network.
# MANAGEMENT_SERVER_PORT=8081
# MEMAY_MANAGEMENT_EXPOSURE=health,imagejobs
MEMAY_IMAGE_WORKER_TOKEN=
# Worker-only origin on the internal management network
MEMAY_IMAGE_WORKER_ORIGIN=http://backend:8081
# Backend-only service-account key mounted outside the repository
MEMAY_DRIVE_CREDENTIALS_FILE=
